# Copy to `.env` (gitignored) and fill in. Nothing here is read from git.
#
# Without .env the run still works: it prints the digest instead of sending it,
# and says so in the first four lines of output. That is not a failure mode,
# it is the default.

# --- Scoring input ---------------------------------------------------------
# Path to a resume or profile text file. Absolute, or relative to the project
# root. Keeping it OUTSIDE this directory is the better choice, because a file
# that never enters the repo cannot be committed from it.
# Without this the `fit` axis collapses to a constant 5 for every event,
# because the model has nothing to compare against, and ranking is then
# decided by access_value alone. A path that names no file fails the run
# rather than falling back to an empty profile.
PROFILE_PATH=

# --- Mailbox to READ (the gmail_label source) ------------------------------
# One account. An app password, not your login password.
# Leave the first two blank to skip mailbox reading; the run prints a [skip]
# line rather than failing, so an unset credential cannot pass for a quiet
# mailbox.
GMAIL_READ_USER=
GMAIL_READ_APP_PASSWORD=
# Comma separated, one Gmail label per item, e.g. events,events/employers.
# A LABEL NAME MUST NOT CONTAIN A COMMA. Gmail permits one, but it would split
# here into two names that match nothing, and a label matching nothing looks
# exactly like a quiet week. Surrounding spaces are trimmed; spaces inside a
# name are kept, since Gmail counts them as part of it.
GMAIL_READ_LABELS=

# --- Mailbox to SEND FROM, and where the digest goes -----------------------
# ALL THREE are required before any email is sent. Miss one and the run falls
# back to printing, which is exactly what happens when .env does not exist.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=

# --- Optional --------------------------------------------------------------
# Scoring tier order is OpenAI API > the first installed llm_clis entry in
# config.yaml > keyword-only. Leaving this blank uses a local CLI, which needs
# no key.
OPENAI_API_KEY=
# Comma separated CLI names, best first, e.g. claude,codex. Reorders the
# llm_clis list and drops any name left out. Blank keeps config.yaml's order,
# and a name config.yaml does not define fails the run.
LLM_CLIS=
# Full path to a CLI that is not on PATH. Only needed on such a machine.
CLAUDE_CLI=
AGY_CLI=
GPT_CLI=
